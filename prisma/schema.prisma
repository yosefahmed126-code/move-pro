generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id   Int    @id @default(autoincrement())
  code String @unique

  name      String
  gender    Gender?
  birthDate DateTime?

  mobile  String
  mobile2 String?

  email      String?
  nationalId String?
  address    String?

  patientPackages PatientPackage[]

  status PatientStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([mobile])
  @@index([nationalId])
}

model Therapist {
  id Int @id @default(autoincrement())

  code String @unique

  name String

  mobile String?
  email  String? @unique

  specialty String?
  notes     String?

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  appointments Appointment[]

  workingHours TherapistWorkingHour[]

  status TherapistStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([name])
  @@index([branchId])
  @@index([status])
}

model TherapistWorkingHour {
  id Int @id @default(autoincrement())

  therapistId Int
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  dayOfWeek Int

  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([therapistId, dayOfWeek])
  @@index([therapistId])
  @@index([dayOfWeek])
}

model Appointment {
  id Int @id @default(autoincrement())

  code String @unique

  patientPackageId Int
  patientPackage   PatientPackage @relation(fields: [patientPackageId], references: [id])

  therapistId Int
  therapist   Therapist @relation(fields: [therapistId], references: [id])

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  createdById Int?
  createdBy   User? @relation("AppointmentCreator", fields: [createdById], references: [id])

  checkedInAt DateTime?

  checkedInById Int?
  checkedInBy   User? @relation("AppointmentCheckIn", fields: [checkedInById], references: [id])

  sessionNumber Int

  date DateTime

  startTime DateTime
  endTime   DateTime

  duration Int @default(40)

  status AppointmentStatus @default(BOOKED)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patientPackageId, sessionNumber])
  @@index([patientPackageId])
  @@index([therapistId])
  @@index([branchId])
  @@index([date])
  @@index([status])
  @@index([createdById])
  @@index([checkedInById])
}

model Package {
  id Int @id @default(autoincrement())

  name String @unique

  sessions Int
  price    Float

  allowedExcuses Int @default(0)

  status PackageStatus @default(ACTIVE)

  patientPackages PatientPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Branch {
  id      Int     @id @default(autoincrement())
  code    String  @unique
  name    String
  address String?
  phone   String?
  email   String?
  isMain  Boolean @default(false)

  status BranchStatus @default(ACTIVE)

  therapists Therapist[]

  patientPackages PatientPackage[]

  appointments Appointment[]

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model User {
  id Int @id @default(autoincrement())

  fullName String

  username String @unique

  passwordHash String

  phone String?
  email String? @unique

  status UserStatus @default(ACTIVE)

  role UserRole

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  createdPackages PatientPackage[] @relation("PackageCreator")

  createdAppointments Appointment[] @relation("AppointmentCreator")

  checkedInAppointments Appointment[] @relation("AppointmentCheckIn")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([status])
}

model PatientPackage {
  id Int @id @default(autoincrement())

  code String @unique

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  packageId Int
  package   Package @relation(fields: [packageId], references: [id])

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  createdById Int
  createdBy   User @relation("PackageCreator", fields: [createdById], references: [id])

  totalSessions Int

  remainingSessions Int

  allowedExcuses Int

  usedExcuses Int @default(0)

  originalPrice Decimal

  discountType DiscountType @default(NONE)

  discountValue Float @default(0)

  finalPrice Decimal

  status PatientPackageStatus @default(ACTIVE)

  purchasedAt DateTime @default(now())

  completedAt DateTime?

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([packageId])
  @@index([branchId])
  @@index([createdById])
  @@index([status])
}

enum DiscountType {
  NONE
  FIXED
  PERCENTAGE
}

enum TherapistStatus {
  ACTIVE
  INACTIVE
}

enum PackageStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PatientPackageStatus {
  ACTIVE
  UPCOMING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  EXCUSED
  MISSED
  CANCELLED_BY_MANAGER
}

enum Gender {
  MALE
  FEMALE
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UserRole {
  SUPER_ADMIN
  BRANCH_MANAGER
  RECEPTIONIST
  THERAPIST
  ACCOUNTANT
}
